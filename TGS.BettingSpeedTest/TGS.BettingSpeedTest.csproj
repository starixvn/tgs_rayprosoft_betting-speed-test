<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net5.0</TargetFramework>
        <Configurations>Debug;Release;LOCAL;DEV;STAGING;PROD</Configurations>
        <Platforms>AnyCPU</Platforms>
        <AssemblyVersion>0.0.1</AssemblyVersion>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'LOCAL' ">
      <DefineConstants>TRACE;LOCAL</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='DEV'">
      <DefineConstants>TRACE;DEV</DefineConstants>
    </PropertyGroup>

    
    <ItemGroup>
      <PackageReference Include="CommandLineParser" Version="2.8.0" />
      <PackageReference Include="NLog" Version="4.7.9" />
      <PackageReference Include="NLog.Config" Version="4.7.9" />
      <PackageReference Include="NLog.Schema" Version="4.7.9" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="nlog.config" />
    </ItemGroup>

</Project>
